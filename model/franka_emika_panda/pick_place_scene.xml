<mujoco model="pick_place_scene">
  <include file="mjx_panda.xml"/>



  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <mesh name="plant_mesh" file="plant.stl" scale="0.03 0.03 0.03"/>
    <mesh name="tray_assembly_mesh" file="tray_assembly.stl" scale="0.0008 0.0008 0.0008"/>

  </asset>

  <worldbody>
  <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="table" pos="0 0.5 0.4">
      <geom type="box" size="0.5 0.3 0.05" rgba="0.5 0.5 0.5 1"/>
    </body>

    <body name="tray_assembly" pos="0.2 0.5 0.45" euler="0 0 1.5708">
      <geom type="mesh" mesh="tray_assembly_mesh" rgba="0 0 0 1"/>
    </body>

    <body name="cube" pos="-0.3 0.5 0.47">
      <geom type="box" size="0.02 0.02 0.02" rgba="0.6 0.3 0.1 1"/>
    </body>

    <body name="plant" pos="-0.3 0.5 0.6" euler="1.5708 0 0">
      <geom type="mesh" mesh="plant_mesh" rgba="0 1 0 1"/>
    </body>

  </worldbody>
</mujoco>
