<mujoco model="pick_place_scene">
  <include file="mjx_panda.xml"/>


<!-- load cad models -->
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <mesh name="plant_mesh" file="plant.stl" scale="0.03 0.03 0.03"/>
    <mesh name="tray_pick_up" file="small_float.stl" scale="0.001 0.001 0.001"/>
    <mesh name="tray_place_down" file="large_float.stl" scale="0.0006 0.0006 0.0006"/>

  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

  <!-- table is 1.0mx1.2m-->
    <body name="table" pos="0.6 0 0.2">
      <geom name="table_collision" type="box" size="0.4 0.6 0.05" rgba="0.5 0.5 0.5 1" contype="1"/>
    </body>
  <!-- coordinate system origin is in right bottom corner -->
    <body name="tray_pick_up" pos="0.3 0.1 0.25" euler="1.5708 0 0">
      <geom name="tray_pick_up_mesh" type="mesh" mesh="tray_pick_up" rgba="0.2 0.2 0.2 1"/>
      <geom name="tray_pick_up_collision" type="box" size="0.1 0.1 0.02" rgba="0 0 0 0" contype="1" conaffinity="1" group="3"/>
    </body>

    <body name="tray_place_down" pos="0.25 -0.5 0.25" euler="1.5708 0 0">
      <geom name="tray_place_down_mesh" type="mesh" mesh="tray_place_down" rgba="0.2 0.2 0.2 1"/>
      <geom name="tray_place_down_collision" type="box" size="0.1 0.1 0.02" rgba="0 0 0 0" contype="1" conaffinity="1" group="3"/>
    </body>

<!-- plants -->
<!-- right tray (place down)-->
  <body name="plant_1" pos="0.35 -0.33 0.3">
    <geom name="plant_1_mesh" type="mesh" mesh="plant_mesh" pos="0 0 0.15" euler="1.5708 0 0" rgba="0 1 0 1"/>
     <geom name="plant_1_cube" type="box" size="0.0225 0.0225 0.0225" pos="0 0 0.02" rgba="0.6 0.3 0.1 1" 
        contype="2" 
        conaffinity="2"/>
  </body>

  <body name="plant_2" pos="0.52 -0.33 0.3">
    <geom name="plant_2_mesh" type="mesh" mesh="plant_mesh" pos="0 0 0.15" euler="1.5708 0 0" rgba="0 1 0 1"/>
     <geom name="plant_2_cube" type="box" size="0.0225 0.0225 0.0225" pos="0 0 0.02" rgba="0.6 0.3 0.1 1" 
        contype="2" 
        conaffinity="2"/>
  </body>


  <body name="plant_5" pos="0.45 0.4 0.4">
    <!-- <geom name="plant_5_mesh" type="mesh" mesh="plant_mesh" pos="0 0 0.15" euler="1.5708 0 0" rgba="0 1 0 1"/> -->
    <geom name="plant_5_cube" type="box" size="0.0225 0.0225 0.0225" rgba="0.6 0.3 0.1 1" 
        contype="2" 
        conaffinity="2"/>
  </body>

  </worldbody>
</mujoco>
